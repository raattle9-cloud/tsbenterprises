__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
env/

# Django
*.log
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# Test files
tests/
test_*.py
*_test.py

# Other
UserData.sh
serversideInstructions.txt
CLEANUP_REPORT.md
BACKEND_OVERVIEW.md
